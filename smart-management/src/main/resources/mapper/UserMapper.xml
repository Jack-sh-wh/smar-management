<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="web.smartmanagement.mapper.UserMapper">

    <insert id="register" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO user (username, password, phone)
        VALUES (#{username}, #{password}, #{phone})
    </insert>
    <insert id="approve">
        INSERT INTO house (id,username,phone,danyuan,haolou,fanghao)
        VALUES (#{id},#{username},#{phone},#{danyuan},#{haolou},#{fanghao})
    </insert>

    <insert id="addvisitor" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO visitor (user_id, visitor_name, visitor_phone)
        VALUES (#{userId}, #{visitorName}, #{visitorPhone})
    </insert>

    <insert id="repair" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO repair (user_id, goods, reason)
        VALUES (#{userId}, #{goods}, #{reason})
    </insert>

    <insert id="addcarnumber" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO carnumber (user_id, carnumber)
        VALUES (#{userId}, #{carnumber})
    </insert>

    <insert id="addadvice" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO advice (user_id, content)
        VALUES (#{userId}, #{content})
    </insert>


    <select id="list" resultType="web.smartmanagement.pojo.User">
        SELECT * FROM user
        <where>
            <if test="phone != null and phone != ''">
                AND phone LIKE CONCAT('%', #{phone}, '%')
            </if>
        </where>
        ORDER BY id DESC
    </select>



</mapper>
